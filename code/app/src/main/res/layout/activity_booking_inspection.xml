<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <Button
            android:id="@+id/inspection_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_secondary_button"
            android:text="@string/back_to_home"
            android:textAllCaps="false"
            android:textColor="@color/leaf_green_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/inspection_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <ProgressBar
            android:id="@+id/inspection_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/inspection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_message"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <Button
            android:id="@+id/inspection_retry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/inspection_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_form_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/inspection_booking_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_message"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/inspection_return_question"
                android:textColor="@color/text_primary" />

            <RadioGroup
                android:id="@+id/inspection_return_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/inspection_unreturned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inspection_unreturned" />

                <RadioButton
                    android:id="@+id/inspection_returned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inspection_returned" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/inspection_condition_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/inspection_condition_question"
                    android:textColor="@color/text_primary" />

                <RadioGroup
                    android:id="@+id/inspection_condition_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/inspection_no_damage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspection_no_damage" />

                    <RadioButton
                        android:id="@+id/inspection_damaged"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspection_damaged" />
                </RadioGroup>

                <EditText
                    android:id="@+id/inspection_damage_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/inspection_damage_description_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/inspection_damage_charge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/inspection_damage_charge_hint"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />
            </LinearLayout>

            <Button
                android:id="@+id/inspection_save"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/inspection_save"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
