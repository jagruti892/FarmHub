<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <Button
        android:id="@+id/equipment_back_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_secondary_button"
        android:text="@string/equipment_catalog_back_home"
        android:textAllCaps="false"
        android:textColor="@color/leaf_green_dark" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/equipment_catalog_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/equipment_catalog_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/equipment_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/equipment_state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_message"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/equipment_retry_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_primary_button"
        android:text="@string/retry"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone" />

    <ListView
        android:id="@+id/equipment_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:visibility="gone" />

    <Button
        android:id="@+id/equipment_load_more_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_secondary_button"
        android:enabled="true"
        android:text="@string/equipment_catalog_load_more"
        android:textAllCaps="false"
        android:textColor="@color/leaf_green_dark"
        android:visibility="gone" />
</LinearLayout>
