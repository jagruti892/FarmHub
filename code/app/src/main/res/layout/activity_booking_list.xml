<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical"
    android:padding="18dp">

    <Button
        android:id="@+id/booking_list_back"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_secondary_button"
        android:text="@string/back_to_home"
        android:textAllCaps="false"
        android:textColor="@color/leaf_green_dark" />

    <TextView
        android:id="@+id/booking_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="25sp" />

    <ProgressBar
        android:id="@+id/booking_list_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/booking_list_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_message"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <Button
        android:id="@+id/booking_list_retry"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_primary_button"
        android:text="@string/retry"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone" />

    <ListView
        android:id="@+id/booking_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:text="@string/footer_text"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
