<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_nav_item"
    android:orientation="vertical"
    android:padding="10dp">

    <include layout="@layout/item_equipment_card" />

    <TextView
        android:id="@+id/owner_equipment_damage_charge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />


<Button
    android:id="@+id/owner_equipment_edit"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_secondary_button"
    android:text="Edit Equipment"
    android:textAllCaps="false"
    android:textColor="@color/leaf_green_dark" />

    <Button
        android:id="@+id/owner_equipment_edit_damage_charge"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_secondary_button"
        android:text="@string/owner_damage_charge_edit"
        android:textAllCaps="false"
        android:textColor="@color/leaf_green_dark" />
</LinearLayout>
